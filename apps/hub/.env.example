# Gera com: npm run hash-password -- "a-tua-password"
HUB_PASSWORD_HASH=
# Texto aleatório longo (ex.: openssl rand -hex 32)
HUB_SESSION_SECRET=
# Base de dados Turso (no Vercel: Storage → Turso preenche estas duas sozinho).
# Sem elas, usa o ficheiro local HUB_DB_FILE.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
HUB_DB_FILE=./data/hub.db
