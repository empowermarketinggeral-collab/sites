# Gera com: npm run hash-password -- "a-tua-password"
HUB_PASSWORD_HASH=
# Texto aleatório longo (ex.: openssl rand -hex 32)
HUB_SESSION_SECRET=
# Base de dados Supabase (no Vercel: Storage → Supabase preenche esta variável sozinho).
# Sem ela, usa um Postgres local em ficheiro na pasta HUB_DB_DIR.
POSTGRES_URL=
HUB_DB_DIR=./data/pglite
