---
interface Props { title: string; wide?: boolean }
const { title } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Início', icon: 'M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z' },
  { href: '/analytics', label: 'Análises', icon: 'M5 20V10M12 20V4M19 20v-7' },
  { href: '/sites', label: 'Sites', icon: 'M3 5h18v14H3zM3 9h18' },
  { href: '/clients', label: 'Clientes', icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0' },
  { href: '/domains', label: 'Domínios', icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18' },
];
---
<!doctype html>
<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title} · Empower Hub</title>
  </head>
  <body>
    <aside class="side">
      <a href="/" class="brand"><span aria-hidden="true">✦</span> Empower Hub</a>
      <nav aria-label="Principal">
        {links.map((l) => (
          <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={l.icon} /></svg>{l.label}
          </a>
        ))}
      </nav>
      <form method="post" action="/logout" class="logout"><button class="ghost">Sair</button></form>
    </aside>
    <main>
      <div class="head">
        <h1>{title}</h1>
        <slot name="actions" />
      </div>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --page: #f1f1f1; --surface: #ffffff; --line: #e3e3e3; --text: #1a1a1a; --text-2: #52514e; --muted: #737373;
    --side: #1c0f2e; --side-2: #2a1540; --side-text: #e9e3f1; --accent: #3a1d5c;
    --series-1: #2a78d6; --series-prev: #86b6ef; --s1: #2a78d6; --s2: #eb6834; --s3: #1baf7a;
    --o1: #2a78d6; --o2: #5598e7; --o3: #86b6ef;
    --grid: #ebebeb; --axis: #c3c2b7; --good: #006300; --bad: #b42318; --warn: #8a5a00;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      color-scheme: dark;
      --page: #0d0c10; --surface: #1b1722; --line: #2e2838; --text: #f2eff5; --text-2: #c3c2b7; --muted: #a59fae;
      --side: #140a21; --side-2: #231238; --accent: #6b3fa0;
      --series-1: #3987e5; --series-prev: #1c5cab; --s1: #3987e5; --s2: #d95926; --s3: #199e70;
      --o1: #5598e7; --o2: #256abf; --o3: #184f95;
      --grid: #2c2835; --axis: #383541; --good: #0ca30c; --bad: #f08a8a; --warn: #f0c36b;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--page); color: var(--text); font: 14px/1.45 system-ui, -apple-system, 'Segoe UI', sans-serif; display: grid; grid-template-columns: 220px 1fr; min-height: 100vh; }
  a { color: var(--series-1); }
  .side { background: linear-gradient(180deg, var(--side-2), var(--side)); color: var(--side-text); padding: 1rem .7rem; display: flex; flex-direction: column; gap: 1rem; position: sticky; top: 0; height: 100vh; }
  .side .brand { color: #fff; text-decoration: none; font-weight: 600; padding: .3rem .6rem; font-size: 1.05rem; }
  .side nav { display: grid; gap: 2px; }
  .side nav a { display: flex; align-items: center; gap: .6rem; color: var(--side-text); text-decoration: none; padding: .45rem .6rem; border-radius: 8px; }
  .side nav a:hover { background: rgba(255,255,255,.06); }
  .side nav a[aria-current] { background: rgba(255,255,255,.12); color: #fff; font-weight: 600; }
  .side svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .logout { margin-top: auto; }
  .side .logout button { width: 100%; color: var(--side-text); border-color: rgba(255,255,255,.2); }
  main { padding: 1.2rem clamp(16px, 3vw, 2rem) 4rem; min-width: 0; max-width: 1400px; }
  .head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  h1 { font-size: 1.35rem; font-weight: 650; margin: 0; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 1rem 1.1rem; min-width: 0; box-shadow: 0 1px 0 rgba(0,0,0,.04); }
  .card-title { font-size: .95rem; font-weight: 650; margin: 0 0 .9rem; text-decoration: underline dotted var(--axis); text-underline-offset: 4px; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .grid-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; }
  .span-2 { grid-column: span 2; }
  .stack > * + * { margin-top: 1rem; }
  .muted { color: var(--muted); }
  .stat { display: grid; gap: .15rem; }
  .stat b { font-size: 1.6rem; font-weight: 650; }
  .delta { font-size: .8rem; font-weight: 600; white-space: nowrap; }
  .delta.good { color: var(--good); } .delta.bad { color: var(--bad); } .delta.flat { color: var(--muted); }
  .pill { display: inline-flex; gap: .3rem; align-items: center; padding: .1rem .55rem; border-radius: 99px; font-size: .78rem; font-weight: 600; background: color-mix(in srgb, currentColor 12%, transparent); }
  .pill.good { color: var(--good); } .pill.bad { color: var(--bad); } .pill.warn { color: var(--warn); }

  /* Filtros */
  .filters { display: flex; flex-wrap: wrap; gap: .5rem; }
  .filters select, .chip { background: var(--surface); color: var(--text); border: 1px solid var(--line); border-radius: 10px; padding: .4rem .7rem; font: inherit; font-weight: 600; }
  .chip { display: inline-flex; align-items: center; gap: .4rem; }

  /* Lista de barras */
  .barlist { list-style: none; margin: 0; padding: 0; display: grid; gap: .8rem; }
  .bl-label { display: block; color: var(--text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: .2rem; }
  .bl-row { display: grid; grid-template-columns: minmax(0, 1fr) 2.5rem 4.5rem; align-items: center; gap: .5rem; }
  .bl-row .track { display: block; }
  .bl-row .bar { display: block; height: 12px; border-radius: 0 4px 4px 0; background: var(--series-1); min-width: 2px; }
  .bl-row.prev { margin-top: 2px; }
  .bl-row .bar.prev { background: var(--series-prev); height: 10px; }
  .bl-val { font-variant-numeric: tabular-nums; font-size: .85rem; text-align: right; }

  /* Gráfico de linhas */
  .linechart { width: 100%; height: auto; display: block; }
  .linechart .grid { stroke: var(--grid); stroke-width: 1; }
  .linechart .tick { fill: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
  .linechart .line { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .linechart .line.cur { stroke: var(--series-1); }
  .linechart .line.prev { stroke: var(--series-prev); }
  .linechart .end { fill: var(--series-1); stroke: var(--surface); stroke-width: 2; }
  .linechart .hit rect { fill: transparent; }
  .linechart .hit .cross { stroke: var(--axis); opacity: 0; }
  .linechart .hit:hover .cross { opacity: 1; }
  .legend { list-style: none; padding: 0; margin: .6rem 0 0; display: flex; flex-wrap: wrap; gap: .4rem 1rem; color: var(--text-2); font-size: .82rem; }
  .legend li { display: inline-flex; align-items: center; gap: .35rem; }
  .swatch { width: 10px; height: 10px; border-radius: 99px; background: var(--series-1); display: inline-block; }
  .swatch.prev { background: var(--series-prev); }
  .swatch.s1 { background: var(--s1); } .swatch.s2 { background: var(--s2); } .swatch.s3 { background: var(--s3); }

  /* Donut */
  .donut { display: grid; justify-items: center; }
  .donut svg { width: min(200px, 100%); }
  .donut-track { fill: none; stroke: var(--grid); stroke-width: 22; }
  .donut-arc { fill: none; stroke-width: 22; }
  .donut-arc.s1 { stroke: var(--s1); } .donut-arc.s2 { stroke: var(--s2); } .donut-arc.s3 { stroke: var(--s3); }
  .donut-total { fill: var(--text); font-size: 28px; font-weight: 650; }
  .donut-delta { margin-top: -.3rem; }

  /* Funil */
  .funnel { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
  .fn-step { display: grid; gap: .1rem; padding: 0 .5rem; border-left: 1px solid var(--line); }
  .fn-step:first-child { border-left: 0; padding-left: 0; }
  .fn-step b { font-size: 1.1rem; }
  .fn-col { height: 140px; display: flex; align-items: flex-end; margin-top: .6rem; }
  .fn-bar { width: 100%; border-radius: 4px 4px 0 0; }
  .fn-bar.o1 { background: var(--o1); } .fn-bar.o2 { background: var(--o2); } .fn-bar.o3 { background: var(--o3); }

  /* Tabelas e formulários */
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: .55rem .5rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 500; font-size: .82rem; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .table-wrap { overflow-x: auto; }
  form.edit { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: .8rem; align-items: end; }
  label { display: grid; gap: .25rem; font-size: .82rem; color: var(--muted); }
  input, select, textarea { background: var(--page); color: var(--text); border: 1px solid var(--line); border-radius: 8px; padding: .5rem .6rem; font: inherit; }
  button { background: var(--accent); color: #fff; border: 0; border-radius: 8px; padding: .55rem 1rem; font: inherit; font-weight: 600; cursor: pointer; }
  button.ghost { background: transparent; border: 1px solid var(--line); color: var(--text); }
  button.danger { background: transparent; color: var(--bad); border: 1px solid var(--line); padding: .3rem .7rem; }
  code, pre { font: 12px/1.5 ui-monospace, 'SF Mono', Menlo, monospace; }
  pre { background: var(--page); border: 1px solid var(--line); border-radius: 8px; padding: .7rem; overflow-x: auto; white-space: pre-wrap; word-break: break-all; }
  details summary { cursor: pointer; color: var(--muted); font-size: .85rem; margin-top: .6rem; }

  @media (max-width: 1000px) {
    .grid-3 { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    body { grid-template-columns: 1fr; }
    .side { position: static; height: auto; flex-direction: row; align-items: center; overflow-x: auto; padding: .5rem; }
    .side nav { display: flex; }
    .side .brand { white-space: nowrap; }
    .logout { margin-top: 0; margin-left: auto; }
    .grid-3 { grid-template-columns: 1fr; }
    .span-2 { grid-column: auto; }
  }
</style>
