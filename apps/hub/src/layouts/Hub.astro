---
import '@fontsource/quicksand/500.css';
import '@fontsource/quicksand/600.css';
import '@fontsource/quicksand/700.css';
import '@fontsource/bodoni-moda/700.css';
import '@fontsource/bodoni-moda/900.css';

interface Props { title: string; wide?: boolean }
const { title } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Início', icon: 'M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z' },
  { href: '/analytics', label: 'Análises', icon: 'M5 20V10M12 20V4M19 20v-7' },
  { href: '/clientes', label: 'Clientes', icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0' },
  { href: '/leads', label: 'Leads', icon: 'M4 6h16v12H4zM4 7l8 6 8-6' },
  { href: '/vendas', label: 'Vendas', icon: 'M6 6h15l-1.5 9h-12zM6 6L5 3H2M9 20h.01M18 20h.01' },
  { href: '/sites', label: 'Sites', icon: 'M3 5h18v14H3zM3 9h18' },
  { href: '/domains', label: 'Domínios', icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18' },
];
---
<!doctype html>
<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F5F1EA" />
    <meta name="apple-mobile-web-app-title" content="Hub" />
    <title>{title} · Empower Hub</title>
  </head>
  <body>
    <aside class="side">
      <a href="/" class="brand"><img src="/favicon.svg" alt="" width="30" height="30" /><span>Empower <b>Hub</b><span class="brand-dot">.</span></span></a>
      <nav aria-label="Principal">
        {links.map((l) => (
          <a href={l.href} aria-current={path === l.href || (l.href !== '/' && path.startsWith(`${l.href}/`)) ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={l.icon} /></svg>{l.label}
          </a>
        ))}
      </nav>
      <form method="post" action="/logout" class="logout"><button class="ghost">Sair</button></form>
    </aside>
    <main>
      <div class="head">
        <h1>{title}</h1>
        <slot name="actions" />
      </div>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* Empower Hub: identidade Empower Boss (papel, preto, dourado; Bodoni Moda e Quicksand; cantos de 3px, sem sombras).
     Cores dos gráficos validadas (daltonismo, contraste) para cada fundo: roxo Empower, dourado e verde Norte;
     o período anterior é cinza, para o atual se destacar. Só tema claro, também com o sistema em modo escuro. */
  :root {
    color-scheme: light;
    --page: #F5F1EA; --surface: #FFFFFF; --surface-2: #FAF8F4; --line: #E6E0D5; --line-strong: #D2CABB;
    --text: #121212; --text-2: #4A4642; --muted: #6B655D;
    --side: #FBF9F5; --side-hover: #F1ECE3; --side-active: #EDE7DC;
    --accent: #121212; --on-accent: #F5F1EA; --link: #5E3A8C; --gold: #B8913A; --gold-text: #8A6A22;
    --series-1: #7C52A8; --series-prev: #A39DAD; --s1: #7C52A8; --s2: #A57E2C; --s3: #1F8A70;
    --grid: #EEE9E0; --axis: #D2CABB; --good: #1F7A4D; --bad: #B3261E; --warn: #8A5A00;
    --display: 'Bodoni Moda', Didot, Georgia, serif; --sans: 'Quicksand', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --r: 3px;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--page); color: var(--text);
    font: 500 15px/1.5 var(--sans); -webkit-font-smoothing: antialiased;
    display: grid; grid-template-columns: 232px 1fr; min-height: 100vh;
  }
  a { color: var(--link); text-underline-offset: 3px; text-decoration-thickness: 1px; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }

  /* Menu lateral: claro, a página ativa marcada a dourado */
  .side { background: var(--side); border-right: 1px solid var(--line); padding: 1.1rem .8rem; display: flex; flex-direction: column; gap: 1.2rem; position: sticky; top: 0; height: 100vh; }
  .side .brand { display: flex; align-items: center; gap: .6rem; color: var(--text); text-decoration: none; padding: .2rem .5rem; font-family: var(--display); font-weight: 700; font-size: 1.15rem; letter-spacing: -.01em; }
  .side .brand img { border-radius: var(--r); border: 1px solid var(--line); }
  .side .brand b { font-weight: 900; }
  .brand-dot { color: var(--gold); font-weight: 900; }
  .side nav { display: grid; gap: 2px; }
  .side nav a { position: relative; display: flex; align-items: center; gap: .65rem; color: var(--text-2); text-decoration: none; padding: .5rem .65rem; border-radius: var(--r); font-weight: 600; }
  .side nav a:hover { background: var(--side-hover); color: var(--text); }
  .side nav a[aria-current] { background: var(--side-active); color: var(--text); font-weight: 700; }
  .side nav a[aria-current]::before { content: ''; position: absolute; left: -.8rem; top: 6px; bottom: 6px; width: 3px; background: var(--gold); border-radius: 0 2px 2px 0; }
  .side svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .logout { margin-top: auto; }
  .side .logout button { width: 100%; }

  main { padding: 1.4rem clamp(16px, 3vw, 2.2rem) 4rem; min-width: 0; max-width: 1440px; }
  .head { display: flex; align-items: center; justify-content: space-between; gap: .8rem 1rem; flex-wrap: wrap; margin-bottom: 1.1rem; }
  h1 { font-family: var(--display); font-weight: 700; font-size: clamp(1.55rem, 2.4vw, 1.9rem); letter-spacing: -.015em; line-height: 1.15; margin: 0; }
  h2, h3 { font-family: var(--sans); }

  /* Folhas */
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 1.05rem 1.15rem; min-width: 0; }
  .card-title { font-size: .98rem; font-weight: 700; margin: 0 0 .9rem; color: var(--text); }
  .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .grid-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(145px, 1fr)); gap: 1rem; }
  .span-2 { grid-column: span 2; }
  .stack > * + * { margin-top: 1rem; }
  .muted { color: var(--muted); }

  /* Indicadores */
  .stat { display: grid; gap: .2rem; align-content: start; }
  .stat > .muted:first-child { font-size: .84rem; font-weight: 600; color: var(--text-2); }
  .stat b { font-size: 1.75rem; font-weight: 700; line-height: 1.15; letter-spacing: -.01em; overflow-wrap: anywhere; }
  .delta { font-size: .8rem; font-weight: 700; white-space: nowrap; }
  .delta.good { color: var(--good); } .delta.bad { color: var(--bad); } .delta.flat { color: var(--muted); }
  .pill { display: inline-flex; gap: .3rem; align-items: center; padding: .08rem .55rem; border-radius: 99px; font-size: .8rem; font-weight: 700; color: var(--text-2); background: color-mix(in srgb, currentColor 10%, transparent); }
  .pill.good { color: var(--good); } .pill.bad { color: var(--bad); } .pill.warn { color: var(--warn); }

  /* Filtros e separadores (uma linha por cima do que filtram) */
  .filters { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  .filters select, .chip { background: var(--surface); color: var(--text); border: 1px solid var(--line-strong); border-radius: var(--r); padding: .42rem .75rem; font: 600 .9rem/1.3 var(--sans); }
  .chip { display: inline-flex; align-items: center; gap: .45rem; text-decoration: none; }
  a.chip:hover { border-color: var(--text-2); }
  .tabs { display: flex; flex-wrap: wrap; gap: .25rem; border-bottom: 1px solid var(--line); }
  .tabs a { padding: .55rem .85rem; margin-bottom: -1px; border-bottom: 2px solid transparent; color: var(--text-2); text-decoration: none; font-weight: 600; }
  .tabs a:hover { color: var(--text); }
  .tabs a[aria-current] { color: var(--text); border-bottom-color: var(--gold); font-weight: 700; }
  /* Segmentos (filtros dentro da página): botões pequenos */
  .segments { display: flex; flex-wrap: wrap; gap: .4rem; }
  .segments a { padding: .32rem .7rem; border: 1px solid var(--line-strong); border-radius: var(--r); background: var(--surface); color: var(--text-2); text-decoration: none; font-weight: 600; font-size: .9rem; }
  .segments a:hover { border-color: var(--text-2); color: var(--text); }
  .segments a[aria-current] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .segments a[aria-current] .muted { color: inherit; opacity: .75; }

  /* Lista de barras: atual (cor) e período anterior (cinza, mais fina) */
  .barlist { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: .85rem; }
  .barlist > li { min-width: 0; }
  .bl-label { display: block; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: .25rem; font-size: .9rem; }
  .bl-row { display: grid; grid-template-columns: minmax(0, 1fr) 2.8rem 4.6rem; align-items: center; gap: .5rem; }
  .bl-row .track { display: block; }
  .bl-row .bar { display: block; height: 10px; border-radius: 0 4px 4px 0; background: var(--series-1); min-width: 2px; }
  .bl-row.prev { margin-top: 3px; }
  .bl-row .bar.prev { background: var(--series-prev); height: 5px; opacity: .8; }
  .bl-val { font-variant-numeric: tabular-nums; font-size: .88rem; font-weight: 700; text-align: right; }
  .bl-row.prev .bl-val { font-weight: 500; font-size: .8rem; }
  .bl-more { margin: 1rem 0 0; font-size: .9rem; font-weight: 600; }

  /* Gráfico de linhas */
  .linechart { width: 100%; height: auto; display: block; overflow: visible; }
  .linechart .grid { stroke: var(--grid); stroke-width: 1; }
  .linechart .baseline { stroke: var(--axis); stroke-width: 1; }
  .linechart .tick { fill: var(--muted); font: 500 11px var(--sans); font-variant-numeric: tabular-nums; }
  .linechart .line { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .linechart .line.cur { stroke: var(--series-1); }
  .linechart .line.prev { stroke: var(--series-prev); stroke-width: 1.5; }
  .linechart .area { fill: color-mix(in srgb, var(--series-1) 8%, transparent); }
  .linechart .end { fill: var(--series-1); stroke: var(--surface); stroke-width: 2; }
  .linechart .hit rect.zone { fill: transparent; }
  .linechart .hit .cross, .linechart .hit .tip, .linechart .hit .pt { opacity: 0; pointer-events: none; }
  .linechart .hit:hover .cross, .linechart .hit:focus .cross, .linechart .hit:hover .tip, .linechart .hit:focus .tip, .linechart .hit:hover .pt, .linechart .hit:focus .pt { opacity: 1; }
  .linechart .hit:focus { outline: none; }
  .linechart .cross { stroke: var(--axis); }
  .linechart .pt.cur { fill: var(--series-1); stroke: var(--surface); stroke-width: 2; }
  .linechart .pt.prev { fill: var(--series-prev); stroke: var(--surface); stroke-width: 2; }
  .linechart .tip rect { fill: var(--surface); stroke: var(--line-strong); }
  .linechart .tip text { fill: var(--text); font: 600 11.5px var(--sans); }
  .linechart .tip .tip-muted { fill: var(--muted); font-weight: 500; }
  .legend { list-style: none; padding: 0; margin: .7rem 0 0; display: flex; flex-wrap: wrap; gap: .4rem 1.1rem; color: var(--text-2); font-size: .84rem; }
  .legend li { display: inline-flex; align-items: center; gap: .4rem; }
  .swatch { width: 10px; height: 10px; border-radius: 99px; background: var(--series-1); display: inline-block; }
  .swatch.prev { background: var(--series-prev); }
  .swatch.s1 { background: var(--s1); } .swatch.s2 { background: var(--s2); } .swatch.s3 { background: var(--s3); }

  /* Donut */
  .donut { display: grid; justify-items: center; }
  .donut svg { width: min(190px, 100%); }
  .donut-track { fill: none; stroke: var(--grid); stroke-width: 20; }
  .donut-arc { fill: none; stroke-width: 20; }
  .donut-arc.s1 { stroke: var(--s1); } .donut-arc.s2 { stroke: var(--s2); } .donut-arc.s3 { stroke: var(--s3); }
  .donut-total { fill: var(--text); font: 700 28px var(--sans); }
  .donut-delta { margin-top: -.3rem; }

  /* Funil: linhas horizontais, uma só cor (cada passo tem o nome) */
  .funnel { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; }
  .fn-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .15rem .6rem; margin-bottom: .3rem; }
  .fn-label { font-size: .9rem; font-weight: 600; color: var(--text-2); }
  .fn-val { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .fn-val b { font-size: 1.05rem; }
  .fn-track { display: block; height: 10px; background: var(--grid); border-radius: 0 4px 4px 0; }
  .fn-bar { display: block; height: 100%; background: var(--series-1); border-radius: 0 4px 4px 0; min-width: 2px; }

  /* Tabelas e formulários */
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: .6rem .55rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  thead th { color: var(--muted); font-weight: 600; font-size: .8rem; border-bottom-color: var(--line-strong); white-space: nowrap; }
  tbody tr:hover td { background: var(--surface-2); }
  tbody tr:last-child td { border-bottom: 0; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .table-wrap { overflow-x: auto; }
  form.edit { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: .85rem; align-items: end; }
  label { display: grid; gap: .3rem; font-size: .84rem; font-weight: 600; color: var(--text-2); }
  input, select, textarea { background: var(--surface); color: var(--text); border: 1px solid var(--line-strong); border-radius: var(--r); padding: .52rem .65rem; font: 500 .95rem/1.35 var(--sans); }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--gold); outline-offset: 0; border-color: var(--gold); }
  button { background: var(--accent); color: var(--on-accent); border: 1px solid var(--accent); border-radius: var(--r); padding: .55rem 1.05rem; font: 700 .92rem/1.2 var(--sans); cursor: pointer; }
  button:hover { opacity: .9; }
  button.ghost { background: transparent; border: 1px solid var(--line-strong); color: var(--text); }
  button.ghost:hover { border-color: var(--text-2); opacity: 1; }
  button.danger { background: transparent; color: var(--bad); border: 1px solid var(--line-strong); padding: .3rem .7rem; }
  code, pre { font: 12px/1.5 ui-monospace, 'SF Mono', Menlo, monospace; }
  pre { background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--r); padding: .75rem; overflow-x: auto; white-space: pre-wrap; word-break: break-all; }
  details summary { cursor: pointer; color: var(--text-2); font-size: .86rem; font-weight: 600; margin-top: .7rem; }

  @media (max-width: 1100px) {
    .grid-3 { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    body { grid-template-columns: 1fr; }
    .side { position: static; height: auto; flex-direction: row; align-items: center; overflow-x: auto; padding: .55rem .6rem; gap: .6rem; border-right: 0; border-bottom: 1px solid var(--line); }
    .side nav { display: flex; }
    .side nav a { white-space: nowrap; }
    .side nav a[aria-current]::before { left: 8px; right: 8px; top: auto; bottom: 0; width: auto; height: 2px; border-radius: 2px 2px 0 0; }
    .side .brand > span { display: none; }
    .logout { margin-top: 0; margin-left: auto; }
    .side .logout button { width: auto; }
    .grid-3 { grid-template-columns: 1fr; }
    .span-2 { grid-column: auto; }
  }
</style>
