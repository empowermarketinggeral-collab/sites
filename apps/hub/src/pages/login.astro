---
import '@fontsource/quicksand/500.css';
import '@fontsource/quicksand/700.css';
import '@fontsource/bodoni-moda/900.css';
import { SESSION_COOKIE, clearFailures, createSession, isLocked, recordFailure, verifyPassword } from '../lib/auth';

let error = '';
if (Astro.request.method === 'POST') {
  const ip = Astro.clientAddress ?? 'unknown';
  if (await isLocked(ip)) {
    error = 'Demasiadas tentativas. Tenta novamente daqui a 15 minutos.';
  } else {
    const form = await Astro.request.formData();
    if (verifyPassword(String(form.get('password') ?? ''))) {
      await clearFailures(ip);
      const { token, maxAge } = createSession();
      Astro.cookies.set(SESSION_COOKIE, token, {
        httpOnly: true, secure: !['localhost', '127.0.0.1'].includes(Astro.url.hostname), sameSite: 'strict', path: '/', maxAge,
      });
      return Astro.redirect('/');
    }
    await recordFailure(ip);
    error = 'Password incorreta.';
  }
}
---
<!doctype html>
<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F5F1EA" />
    <title>Entrar · Empower Hub</title>
  </head>
  <body>
    <form method="post">
      <img src="/favicon.svg" alt="" width="56" height="56" />
      <h1>Empower <b>Hub</b><span class="dot">.</span></h1>
      <p class="sub">Back-office dos sites</p>
      <label>Password <input type="password" name="password" autocomplete="current-password" required autofocus /></label>
      {error && <p class="err" role="alert">{error}</p>}
      <button>Entrar</button>
    </form>
  </body>
</html>

<style>
  body { color-scheme: light; margin: 0; min-height: 100vh; display: grid; place-items: center; background: #F5F1EA; color: #121212; font: 500 15px/1.5 'Quicksand', system-ui, sans-serif; padding: 16px; }
  form { width: 100%; max-width: 360px; display: grid; gap: 1rem; background: #FFFFFF; border: 1px solid #E6E0D5; border-radius: 3px; padding: 2rem; }
  img { border: 1px solid #E6E0D5; border-radius: 3px; }
  h1 { margin: 0; font: 700 1.7rem/1.1 'Bodoni Moda', Georgia, serif; letter-spacing: -.015em; }
  h1 b { font-weight: 900; }
  .dot { color: #B8913A; font-weight: 900; }
  .sub { margin: -.7rem 0 0; color: #6B655D; }
  label { display: grid; gap: .3rem; color: #4A4642; font-weight: 700; font-size: .88rem; }
  input { background: #FFFFFF; color: #121212; border: 1px solid #D2CABB; border-radius: 3px; padding: .65rem; font: inherit; }
  input:focus { outline: 2px solid #B8913A; outline-offset: 0; border-color: #B8913A; }
  button { background: #121212; color: #F5F1EA; border: 0; border-radius: 3px; padding: .7rem; font: 700 1rem 'Quicksand', system-ui, sans-serif; cursor: pointer; }
  .err { color: #B3261E; margin: 0; }
</style>
