---
import Hub from '../layouts/Hub.astro';
import { handleCrud } from '../lib/crud';
import { list, type Client, type Site } from '../lib/db';
import { leadConfig, probeBigBoss, tokenEnvKey } from '../lib/leads';
import { clarityLink } from '../lib/clarity';

const redirect = await handleCrud(Astro, 'sites');
if (redirect) return redirect;

const sites = await list<Site>('sites');
const clients = await list<Client>('clients');
const editing = sites.find((s) => s.id === Astro.url.searchParams.get('edit'));
const clientName = (id: string) => clients.find((c) => c.id === id)?.name ?? '—';
// Teste da ligação ao Big Boss (não cria contactos): /sites?test=<id>.
const testId = Astro.url.searchParams.get('test');
const test = testId && sites.some((s) => s.id === testId) ? { id: testId, ...(await probeBigBoss(testId)) } : null;
const snippet = (id: string) => `<script defer src="${Astro.url.origin}/t.js" data-site="${id}"></script>`;
---
<Hub title="Sites">
  <div class="stack">
    <form method="post" class="card edit">
      <input type="hidden" name="id" value={editing?.id ?? ''} />
      <label>Nome <input name="name" required value={editing?.name} /></label>
      <label>URL <input name="url" type="url" required placeholder="https://" value={editing?.url} /></label>
      <label>Domínio (para validar o tracking) <input name="domain" required placeholder="exemplo.pt" value={editing?.domain} /></label>
      <label>Pasta no repositório <input name="repo" placeholder="apps/..." value={editing?.repo} /></label>
      <label>Cliente
        <select name="client_id">
          <option value="">—</option>
          {clients.map((c) => <option value={c.id} selected={editing?.client_id === c.id}>{c.name}</option>)}
        </select>
      </label>
      <label>Id da marca no Big Boss (vendas Hotmart) <input name="bigboss_brand_id" placeholder="00000000-0000-…" pattern="[0-9a-fA-F\-]{36}" value={editing?.bigboss_brand_id} /></label>
      <label>Id do projeto Microsoft Clarity <input name="clarity_id" placeholder="ex.: abc123xyz" pattern="[a-zA-Z0-9]{4,20}" value={editing?.clarity_id} /></label>
      <button>{editing ? 'Guardar' : 'Adicionar site'}</button>
    </form>

    {sites.map((s) => (
      <section class="card">
        <div class="head" style="margin:0">
          <h2 class="card-title" style="margin:0">{s.name}</h2>
          <div>
            <a href={`/leads?site=${s.id}`}>Leads</a> ·
            {s.bigboss_brand_id && <><a href={`/vendas?site=${s.id}`}>Vendas</a> ·</>}
            {clarityLink(s) && <><a href={clarityLink(s)!} target="_blank" rel="noopener noreferrer">Clarity</a> ·</>}
            <a href={`/analytics?site=${s.id}`}>Análises</a> ·
            <a href={`?edit=${s.id}`}>Editar</a>
            <form method="post" style="display:inline"><input type="hidden" name="id" value={s.id} /><button class="danger" name="_action" value="delete" onclick="return confirm('Apagar este site? As métricas ficam guardadas.')">Apagar</button></form>
          </div>
        </div>
        <p class="muted" style="margin:.4rem 0">
          <a href={s.url} target="_blank" rel="noopener noreferrer">{s.url}</a> · Cliente: {clientName(s.client_id)}{s.repo && ` · ${s.repo}`}
        </p>
        <p class="muted" style="margin:.4rem 0">
          Id: <code>{s.id}</code> · Domínio: <code>{s.domain || '—'}</code> ·
          Big Boss: {leadConfig(s.id).token ? 'token configurado' : <>sem <code>{tokenEnvKey(s.id)}</code></>} ·
          <a href={`?test=${s.id}`}>Testar ligação</a>
        </p>
        {test?.id === s.id && <p class={test.ok ? 'ok' : 'err'} role="status">{test.message}</p>}
        <details>
          <summary>Código de tracking</summary>
          <p class="muted">Cola antes de <code>&lt;/head&gt;</code>. Para medir conversões, junta <code>data-track="lead"</code> ao botão ou link de contacto.</p>
          <pre>{snippet(s.id)}</pre>
          <p class="muted">Formulários: com este código no site, qualquer <code>&lt;form data-hub-form="newsletter"&gt;</code> passa a enviar para a página Leads (e para o Big Boss, se houver token).
            Usa campos com <code>name="email"</code>, <code>name</code>, <code>phone</code>, <code>company</code>, <code>consent_email</code>; os outros ficam como respostas.
            Opcional: <code>data-tags="newsletter:ativo"</code>, <code>data-success="Obrigado!"</code> ou <code>data-redirect="/obrigado"</code>.</p>
        </details>
      </section>
    ))}
  </div>
</Hub>

<style>
  .ok { color: var(--good); margin: .4rem 0; }
  .err { color: var(--bad); margin: .4rem 0; }
</style>
