---
interface Point { date: string; sessions: number }
interface Props { current: Point[]; previous: Point[] }
const { current, previous } = Astro.props;
const W = 640, H = 220, L = 36, R = 8, T = 10, B = 26;
const rawMax = Math.max(1, ...current.map((p) => p.sessions), ...previous.map((p) => p.sessions));
const step = rawMax <= 5 ? 1 : rawMax <= 10 ? 2 : Math.pow(10, Math.floor(Math.log10(rawMax))) * (rawMax / Math.pow(10, Math.floor(Math.log10(rawMax))) > 5 ? 2 : 1);
const max = Math.ceil(rawMax / step) * step;
const ticks = Array.from({ length: Math.round(max / step) + 1 }, (_, i) => i * step);
const n = current.length;
const x = (i: number) => L + (n <= 1 ? 0 : (i / (n - 1)) * (W - L - R));
const y = (v: number) => T + (1 - v / max) * (H - T - B);
const path = (pts: Point[]) => pts.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(p.sessions).toFixed(1)}`).join('');
const fmtDay = new Intl.DateTimeFormat('pt-PT', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const label = (d: string) => fmtDay.format(new Date(`${d}T12:00:00Z`));
const xTicks = [0, Math.round((n - 1) / 3), Math.round((2 * (n - 1)) / 3), n - 1].filter((v, i, a) => a.indexOf(v) === i);
const band = (W - L - R) / Math.max(1, n - 1);
---
<svg class="linechart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Sessões por dia: período atual comparado com o anterior">
  {ticks.map((t) => (
    <g>
      <line class="grid" x1={L} x2={W - R} y1={y(t)} y2={y(t)} />
      <text class="tick" x={L - 8} y={y(t) + 4} text-anchor="end">{t}</text>
    </g>
  ))}
  {xTicks.map((i) => <text class="tick" x={x(i)} y={H - 6} text-anchor={i === 0 ? 'start' : i === n - 1 ? 'end' : 'middle'}>{label(current[i].date)}</text>)}
  <path class="line prev" d={path(previous)} />
  <path class="line cur" d={path(current)} />
  {n > 0 && <circle class="end" cx={x(n - 1)} cy={y(current[n - 1].sessions)} r="4" />}
  {current.map((p, i) => (
    <g class="hit">
      <rect x={x(i) - band / 2} y={T} width={band} height={H - T - B} />
      <line class="cross" x1={x(i)} x2={x(i)} y1={T} y2={H - B} />
      <title>{`${label(p.date)}: ${p.sessions} sessões · período anterior (${label(previous[i]?.date ?? p.date)}): ${previous[i]?.sessions ?? 0}`}</title>
    </g>
  ))}
</svg>
