---
import Delta from './Delta.astro';
interface Props { labels: string[]; current: number[]; previous: number[] }
const { labels, current, previous } = Astro.props;
const pct = (v: number) => (current[0] ? (v / current[0]) * 100 : 0);
const nf = new Intl.NumberFormat('pt-PT');
---
<ol class="funnel">
  {labels.map((l, i) => (
    <li title={`${l}: ${current[i]} (período anterior: ${previous[i]})`}>
      <div class="fn-head">
        <span class="fn-label">{l}</span>
        <span class="fn-val"><b>{pct(current[i]).toFixed(i ? 1 : 0).replace('.', ',')}%</b> <span class="muted">{nf.format(current[i])}</span> <Delta current={current[i]} previous={previous[i]} /></span>
      </div>
      <span class="fn-track"><span class="fn-bar" style={`width:${Math.max(0.5, pct(current[i]))}%`}></span></span>
    </li>
  ))}
</ol>
