---
import { change } from '../lib/analytics';
interface Props { current: number; previous: number; invert?: boolean }
const { current, previous, invert = false } = Astro.props;
const pct = change(current, previous);
const up = pct !== null && pct > 0;
const good = pct === null ? true : invert ? pct < 0 : pct > 0;
const text = pct === null ? 'novo' : pct === 0 ? '—' : `${Math.abs(pct) >= 1000 ? `${(Math.abs(pct) / 1000).toFixed(1).replace('.', ',')} mil` : Math.round(Math.abs(pct))}%`;
---
{pct === 0
  ? <span class="delta flat">—</span>
  : <span class={`delta ${good ? 'good' : 'bad'}`} title="vs. período anterior">{pct === null ? '' : up ? '↗' : '↘'} {text}</span>}
