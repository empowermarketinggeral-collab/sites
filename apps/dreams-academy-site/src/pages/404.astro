---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base title="Página não encontrada — Dreams Academy">
  <section class="page-hero">
    <div class="hero-fabric" aria-hidden="true"></div>
    <div class="wrap page-hero-inner">
      <p class="eyebrow">Erro 404</p>
      <h1 class="display page-title">Esta página <em class="accent">não existe.</em></h1>
      <p class="lead">O endereço pode ter mudado. Começa pelo início.</p>
      <div class="actions"><Button href="/">Voltar ao início</Button></div>
    </div>
  </section>
</Base>
