---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionHead from '../components/SectionHead.astro';
import ProgramCta from '../components/ProgramCta.astro';
import home from '../data/home.json';

const { hero, proof, principle, pillars, freebie } = home;
---
<Base>
  <section class="hero">
    <div class="hero-fabric" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow reveal">{hero.eyebrow}</p>
        <h1 class="display hero-title reveal">{hero.title} <em class="accent">{hero.accent}</em></h1>
        <p class="lead reveal">{hero.text}</p>
        <p class="hero-note reveal">{hero.note}</p>
        <div class="actions reveal">
          <Button href={hero.primaryCta.href} size="lg">{hero.primaryCta.label}</Button>
          <Button href={hero.secondaryCta.href} variant="outline">{hero.secondaryCta.label}</Button>
        </div>
        <p class="hero-tagline reveal">{hero.tagline}</p>
      </div>
      <picture class="hero-mirror reveal">
        <source srcset="/images/espelho-400.webp 400w, /images/espelho.webp 658w" sizes="(max-width: 640px) 160px, (max-width: 900px) 200px, 360px" type="image/webp" />
        <img src="/images/espelho.png" alt="Espelho dourado da Dreams Academy" width="400" height="522" fetchpriority="high" />
      </picture>
    </div>
  </section>

  <section class="proof">
    <ul class="wrap proof-grid">
      {proof.map((p) => (
        <li class="reveal">
          <span class="display proof-value">{p.value}</span>
          <strong>{p.label}</strong>
          <p>{p.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section section-light principle">
    <div class="wrap center">
      <p class="eyebrow reveal">{principle.eyebrow}</p>
      {principle.lines.map((l, i) => <p class:list={['display principle-line reveal', { accent: i === 1 }]}>{l}</p>)}
      <div class="rule reveal" aria-hidden="true"></div>
      <p class="body-lg reveal" style="margin-inline:auto">{principle.text}</p>
    </div>
  </section>

  <section class="section" id="pilares">
    <div class="wrap">
      <SectionHead eyebrow={pillars.eyebrow} title={pillars.title} accent={pillars.accent} center />
      <div class="pillars">
        {pillars.items.map((p) => (
          <article class="pillar reveal">
            <span class="display pillar-n">{p.number}</span>
            <h3 class="card-title">{p.title}</h3>
            <p>{p.text}</p>
            <Button href={p.cta.href} variant="outline">{p.cta.label}</Button>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-light">
    <div class="wrap freebie">
      <div>
        <p class="eyebrow reveal">{freebie.eyebrow}</p>
        <h2 class="display section-title reveal">{freebie.title}<br /><em class="accent">{freebie.accent}</em></h2>
      </div>
      <article class="freebie-card reveal">
        <p class="badge">{freebie.label}</p>
        <h3 class="display freebie-name">{freebie.name}</h3>
        <p class="freebie-sub">{freebie.subtitle}</p>
        <p class="muted">{freebie.text}</p>
        <ul class="checks">{freebie.items.map((i) => <li>{i}</li>)}</ul>
        <Button href={freebie.cta.href} variant="navy" track="lead">{freebie.cta.label}</Button>
      </article>
    </div>
  </section>

  <ProgramCta />
</Base>
