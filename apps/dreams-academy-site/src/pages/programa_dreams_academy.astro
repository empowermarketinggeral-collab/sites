---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionHead from '../components/SectionHead.astro';
import Faq from '../components/Faq.astro';
import page from '../data/programa.json';
import { course, faqPage } from '../lib/schema';

const { meta, hero, problem, includes, results, closing, faq } = page;
const schema = [
  { ...course({ name: 'Programa Dreams Academy — Formação de cabeleireiro em 90 dias', description: meta.description, path: '/programa_dreams_academy', mode: 'blended' }), hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'blended', courseSchedule: { '@type': 'Schedule', duration: 'P90D', repeatFrequency: 'P3M' } } },
  faqPage(faq.items),
];
---
<Base title={meta.title} description={meta.description} schema={schema}>
  <section class="page-hero">
    <div class="hero-fabric" aria-hidden="true"></div>
    <div class="wrap page-hero-inner">
      <p class="eyebrow reveal">{hero.eyebrow}</p>
      <h1 class="display page-title reveal">{hero.title} <em class="accent">{hero.accent}</em></h1>
      <p class="lead reveal">{hero.text}</p>
      <div class="notice reveal">
        <strong>{hero.badge}</strong>
        <span>{hero.note}</span>
      </div>
      <div class="actions reveal"><Button href={hero.cta.href} track="lead" size="lg">{hero.cta.label}</Button></div>
    </div>
  </section>

  <section class="section section-light">
    <div class="wrap">
      <SectionHead eyebrow={problem.eyebrow} title={problem.title} />
      <ul class="pain-grid">{problem.items.map((i) => <li class="reveal">{i}</li>)}</ul>
      <p class="body-lg reveal">{problem.text}</p>
      <div class="scenarios">
        {problem.scenarios.map((s) => (
          <article class="scenario reveal">
            <p class="eyebrow">{s.label}</p>
            <p class="display scenario-text">{s.text}</p>
          </article>
        ))}
      </div>
      <p class="display statement reveal">{problem.closing}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={includes.eyebrow} title={includes.title} text={includes.text} />
      <div class="modules-grid">
        {includes.groups.map((g, n) => (
          <article class="program-module reveal">
            <span class="display step-n">{String(n + 1).padStart(2, '0')}</span>
            <h3 class="card-title">{g.title}</h3>
            <p class="muted">{g.text}</p>
            <ul class="checks checks-light">{g.items.map((i) => <li>{i}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-light">
    <div class="wrap narrow">
      <SectionHead eyebrow={results.eyebrow} title={results.title} />
      <ul class="checks checks-lg">{results.items.map((i) => <li class="reveal">{i}</li>)}</ul>
      <p class="note reveal">{results.note}</p>
    </div>
  </section>

  <section class="section closing">
    <div class="wrap center">
      <h2 class="display section-title title-line reveal">{closing.title}<br /><em class="accent">{closing.accent}</em></h2>
      <p class="reveal"><Button href={hero.cta.href} track="lead" size="lg">{hero.cta.label}</Button></p>
      <p class="muted small reveal">{hero.badge}</p>
    </div>
  </section>

  <Faq eyebrow={faq.eyebrow} title={faq.title} items={faq.items} />
</Base>
