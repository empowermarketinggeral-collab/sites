---
// oneLine: no desktop, o título e o destaque ficam cada um numa só linha (letra um pouco mais pequena).
interface Props { eyebrow?: string; title: string; accent?: string; text?: string; center?: boolean; oneLine?: boolean }
const { eyebrow, title, accent, text, center = false, oneLine = false } = Astro.props;
---
<header class:list={['section-head', { center, wide: oneLine }]}>
  {eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
  <h2 class:list={['display section-title reveal', { 'title-line': oneLine }]}>{title}{accent && <><br /><em class="accent">{accent}</em></>}</h2>
  {text && <p class="section-text reveal">{text}</p>}
</header>
