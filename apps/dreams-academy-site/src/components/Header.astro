---
import Logo from './Logo.astro';
import site from '../data/site.json';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---
<header class="topbar">
  <a href="/" class="brand"><Logo /></a>
  <nav aria-label="Principal">
    <ul>
      {site.nav.map((item) => (
        <li><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
