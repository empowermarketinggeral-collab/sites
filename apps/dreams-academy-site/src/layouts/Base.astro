---
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/400-italic.css';
import '@fontsource/playfair-display/600.css';
import '@fontsource/montserrat/300.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/cinzel/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import CookieConsent from '../components/CookieConsent.astro';
import site from '../data/site.json';

// landing: páginas de venda de produto — cabeçalho só com o logótipo, para não desviar do checkout.
// noindex: páginas que não devem aparecer no Google.
// fabric: a página abre com o tecido de fundo (pré-carregado, é a maior imagem do topo).
// schema: dados estruturados extra (Curso, FAQ…) para o Google perceber o conteúdo.
interface Props { title?: string; description?: string; landing?: boolean; noindex?: boolean; fabric?: boolean; schema?: Record<string, unknown>[] }
const { title = site.meta.title, description = site.meta.description, landing = false, noindex = false, fabric = true, schema = [] } = Astro.props;
// No build o caminho vem como /tecnicadecabelos.html; o endereço público é /tecnicadecabelos.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = new URL(path, site.meta.url).href;
const ogImage = new URL('/images/og.jpg', site.meta.url).href;
const org = {
  '@type': 'EducationalOrganization',
  '@id': `${site.meta.url}/#organizacao`,
  name: 'Dreams Academy',
  url: site.meta.url,
  logo: new URL('/apple-touch-icon.png', site.meta.url).href,
  image: ogImage,
  email: site.company.email,
  description: site.meta.description,
  sameAs: [site.links.instagram],
  knowsAbout: site.meta.keywords,
};
const jsonLd = { '@context': 'https://schema.org', '@graph': [org, { '@type': 'WebSite', '@id': `${site.meta.url}/#site`, url: site.meta.url, name: 'Dreams Academy', inLanguage: 'pt-PT', publisher: { '@id': org['@id'] } }, ...schema] };
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#05204e" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dreams Academy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dreams Academy — espelho dourado e logótipo" />
    <meta property="og:locale" content={site.meta.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    {fabric && <link rel="preload" as="image" href="/images/tecido.webp" type="image/webp" fetchpriority="high" />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {site.analytics.hubUrl && <script is:inline defer src={`${site.analytics.hubUrl}/t.js`} data-site={site.analytics.siteId}></script>}
  </head>
  <body>
    <a class="skip" href="#conteudo">Saltar para o conteúdo</a>
    {landing
      ? <header class="topbar topbar-landing"><a href="/" class="brand"><Logo /></a></header>
      : <Header />}
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal');
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
