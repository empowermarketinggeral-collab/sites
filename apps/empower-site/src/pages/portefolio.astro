---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionHead from '../components/SectionHead.astro';
import p from '../data/portefolio.json';

// Portefólio didático: 4 capítulos pela ordem do método (estratégia → marca → ecossistema → redes e tráfego).
const { meta, hero, order, chapters, glossary, closing } = p;
const [estrategia, marca, ecossistema, redes] = chapters;
// O JSON tem formas diferentes por capítulo: cada bloco de caso vem do seu capítulo.
const estrategiaCase = estrategia.case!;
const marcaCase = marca.case!;
const ecoCase = ecossistema.case!;
const redesResults = redes.results!;
const n = (i: number) => String(i + 1).padStart(2, '0');
---
<Base title={meta.title} description={meta.description}>
  <nav class="pf-rail" aria-label="Capítulos">
    <ol>
      {chapters.map((c, i) => (
        <li><a href={`#${c.id}`} data-rail={c.id}><span>{n(i)}</span><em>{c.title}</em></a></li>
      ))}
    </ol>
  </nav>

  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow reveal">{hero.eyebrow}</p>
      <p class="display struck reveal">{hero.struck}</p>
      <h1 class="display page-title reveal">{hero.title}</h1>
      <p class="lead reveal">{hero.text}</p>
      <div class="actions reveal"><Button href={hero.cta.href} variant="light">{hero.cta.label}</Button></div>
    </div>
  </section>

  <!-- Índice: a ordem do método -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={order.eyebrow} title={order.title} small />
      <p class="body-lg muted reveal">{order.text}</p>
      <ol class="pf-order">
        {order.steps.map((s, i) => (
          <li class:list={['reveal', { late: i === 3 }]}>
            <a href={`#${chapters[i].id}`}>
              <span class="display pf-n">{n(i)}</span>
              <strong>{s.short}</strong>
              <span class="muted">{s.question}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="pf-analogy reveal">{order.analogy}</p>
    </div>
  </section>

  {chapters.map((c, i) => (
    <section class="section pf-chapter" id={c.id} data-chapter={c.id}>
      <div class="wrap">
        <header class="pf-chapter-head">
          <span class="display pf-big-n reveal" aria-hidden="true">{n(i)}</span>
          <div>
            <p class="eyebrow reveal">{c.kicker} de {chapters.length}</p>
            <h2 class="display section-title-sm reveal">{c.title}</h2>
          </div>
        </header>

        <div class="pf-lesson reveal">
          <div>
            <p class="eyebrow">A lição</p>
            <p class="pf-definition">{c.lesson.definition}</p>
          </div>
          <div>
            <ul class="services">{c.lesson.points.map((pt) => <li>{pt}</li>)}</ul>
            <p class="note">{c.lesson.mistake}</p>
          </div>
        </div>

        {c === estrategia && (
          <div class="pf-case">
            <p class="eyebrow reveal">{estrategiaCase.eyebrow}</p>
            <h3 class="card-title reveal">{estrategiaCase.title}</h3>
            <p class="muted pf-case-text reveal">{estrategiaCase.text}</p>
            <ol class="grid-6">
              {estrategiaCase.steps!.map((s, j) => (
                <li class="numbered reveal">
                  <span class="eyebrow">Passo {j + 1}</span>
                  <h4 class="card-title pf-h4">{s.title}</h4>
                  <p>{s.text}</p>
                </li>
              ))}
            </ol>
          </div>
        )}

        {c === marca && (
          <div class="pf-case">
            <p class="eyebrow reveal">{marcaCase.eyebrow}</p>
            <h3 class="card-title reveal">{marcaCase.title}</h3>
            <p class="muted pf-case-text reveal">{marcaCase.text}</p>
            <div class="pf-ba reveal" role="table" aria-label="Dreams Academy: antes e depois">
              <div class="pf-ba-row pf-ba-head" role="row">
                <span role="columnheader"></span><span role="columnheader">Antes</span><span role="columnheader">Depois</span>
              </div>
              {marcaCase.compare!.map((r) => (
                <div class="pf-ba-row" role="row">
                  <span role="rowheader" class="eyebrow">{r.label}</span>
                  <span role="cell" class="pf-before">{r.before}</span>
                  <span role="cell" class="pf-after">{r.after}</span>
                </div>
              ))}
            </div>
            <p class="eyebrow pf-sub reveal">Cada cor tem uma razão</p>
            <ul class="pf-palette">
              {marcaCase.palette!.map((cor) => (
                <li class="reveal">
                  <span class="pf-swatch" style={`background:${cor.hex}`}></span>
                  <strong>{cor.name}</strong>
                  <span class="muted">{cor.why}</span>
                </li>
              ))}
            </ul>
            <blockquote class="quote reveal">“{marcaCase.quote}”<footer class="eyebrow">{marcaCase.quoteBy}</footer></blockquote>
            <p class="center reveal"><a class="link-arrow" href={marcaCase.link!.href}>{marcaCase.link!.label} →</a></p>
          </div>
        )}

        {c === ecossistema && (
          <div class="pf-case">
            <p class="eyebrow reveal">{ecoCase.eyebrow}</p>
            <h3 class="card-title reveal">{ecoCase.title}</h3>
            <p class="muted pf-case-text reveal">{ecoCase.text}</p>
            <div class="pf-eco reveal">
              <div class="pf-map">
                <svg viewBox="0 0 400 340" aria-hidden="true">
                  <defs>
                    <marker id="pf-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                      <path d="M0 0 L10 5 L0 10 z" fill="currentColor" />
                    </marker>
                  </defs>
                  <path d="M228 72 Q 330 110 334 214" />
                  <path d="M290 292 Q 200 330 110 292" />
                  <path d="M66 214 Q 70 110 172 72" />
                </svg>
                {ecoCase.nodes!.map((node, j) => (
                  <button type="button" class:list={['pf-node', `pf-node-${node.id}`]} data-node={node.id} aria-pressed={j === 0 ? 'true' : 'false'}>
                    <span class="pf-node-job">{node.job}</span>
                    <strong>{node.name}</strong>
                    <span class="pf-node-role">{node.role}</span>
                  </button>
                ))}
              </div>
              <div class="pf-panels">
                {ecoCase.nodes!.map((node, j) => (
                  <article class="pf-panel" data-panel={node.id} hidden={j !== 0}>
                    <p class="eyebrow">{node.role} · {node.job}</p>
                    <h4 class="display pf-panel-title">{node.name}</h4>
                    <p>{node.text}</p>
                    <p class="pf-gives"><span class="muted">Entrega ao ecossistema:</span> {node.gives}</p>
                  </article>
                ))}
                <ol class="pf-flow">
                  {ecoCase.flows!.map((f) => <li>{f}</li>)}
                </ol>
              </div>
            </div>
            <p class="eyebrow pf-sub reveal">Os passos de estratégia do ecossistema</p>
            <ol class="steps pf-steps-4">
              {ecoCase.steps!.map((s, j) => (
                <li class="step reveal">
                  <span class="eyebrow">Passo {j + 1}</span>
                  <h4 class="card-title pf-h4">{s.title}</h4>
                  <p>{s.text}</p>
                </li>
              ))}
            </ol>
          </div>
        )}

        {c === redes && (
          <div class="pf-case">
            <p class="eyebrow reveal">Só agora, com a base pronta</p>
            <div class="post-grid">
              {redesResults.map((r) => (
                <a class="post-card reveal" href={r.href}>
                  <div class="post-highlight"><span class="display">{r.value}</span><small>{r.label}</small></div>
                  <p class="eyebrow">{r.name}</p>
                  <p>{r.text}</p>
                  <span class="post-meta">Ler o caso →</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <aside class="pf-exercise reveal">
          <p class="eyebrow">Exercício para a tua marca</p>
          <p>{c.exercise}</p>
        </aside>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={glossary.eyebrow} title={glossary.title} small />
      <dl class="pf-glossary">
        {glossary.items.map((g) => (
          <div class="reveal"><dt>{g.term}</dt><dd>{g.text}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section closing">
    <div class="wrap narrow center">
      <h2 class="display section-title-sm reveal">{closing.title}</h2>
      <p class="body-lg muted reveal" style="margin:1.4rem auto 2rem">{closing.text}</p>
      <div class="actions reveal" style="justify-content:center">
        <Button href={closing.primary.href} variant="light" track="lead">{closing.primary.label}</Button>
        <Button href={closing.secondary.href} variant="outline" track="agendamento">{closing.secondary.label}</Button>
      </div>
    </div>
  </section>
</Base>

<script>
  // Ecossistema: mostra o papel da peça escolhida.
  const nodes = document.querySelectorAll<HTMLButtonElement>('.pf-node');
  const panels = document.querySelectorAll<HTMLElement>('.pf-panel');
  nodes.forEach((btn) => btn.addEventListener('click', () => {
    nodes.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== btn.dataset.node; });
  }));

  // Índice lateral: marca o capítulo que está no ecrã.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-rail]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const id = (e.target as HTMLElement).dataset.chapter;
        links.forEach((a) => a.toggleAttribute('aria-current', a.dataset.rail === id));
      }
    }, { rootMargin: '-45% 0px -50% 0px' });
    document.querySelectorAll('[data-chapter]').forEach((s) => io.observe(s));
  }
</script>

<style>
  /* Índice lateral (só em ecrãs largos) */
  .pf-rail { position: fixed; left: 18px; top: 50%; transform: translateY(-50%); z-index: 10; display: none; }
  .pf-rail ol { display: grid; gap: .9rem; }
  .pf-rail a { display: flex; align-items: center; gap: .6rem; text-decoration: none; color: var(--paper-muted); font-size: .85rem; }
  .pf-rail span { width: 2rem; height: 2rem; display: grid; place-items: center; border-radius: 50%; border: 1px solid rgba(184,156,224,.3); font-size: .75rem; transition: background .25s ease, color .25s ease; }
  .pf-rail em { font-style: normal; opacity: 0; transform: translateX(-6px); transition: opacity .25s ease, transform .25s ease; white-space: nowrap; }
  .pf-rail a:hover em, .pf-rail a:focus-visible em, .pf-rail a[aria-current] em { opacity: 1; transform: none; }
  .pf-rail a[aria-current] { color: var(--paper); }
  .pf-rail a[aria-current] span { background: var(--lilac); color: var(--ink-deep); border-color: var(--lilac); }
  @media (min-width: 1380px) { .pf-rail { display: block; } }

  /* Ordem */
  .pf-order { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin: 3rem 0 2.5rem; counter-reset: none; }
  .pf-order a { display: grid; gap: .5rem; height: 100%; text-decoration: none; padding: 1.6rem; border-radius: var(--radius); border: 1px solid rgba(184,156,224,.18); background: linear-gradient(160deg, #1d1428, #16131b); transition: transform .25s ease, border-color .25s ease; }
  .pf-order a:hover, .pf-order a:focus-visible { transform: translateY(-4px); border-color: var(--lilac); }
  .pf-order strong { font-family: var(--font-serif); font-weight: 600; font-size: 1.4rem; line-height: 1.15; }
  .pf-order .muted { font-size: 1rem; }
  .pf-order .late a { border-style: dashed; }
  .pf-n { font-size: 2.6rem; color: var(--lilac); }
  .pf-analogy { font-family: var(--font-serif); font-size: clamp(1.3rem, 2.4vw, 1.8rem); line-height: 1.3; border-left: 2px solid var(--lilac); padding-left: 1.2rem; max-width: 46ch; margin: 0; }

  /* Capítulos */
  .pf-chapter-head { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.5rem); margin-bottom: 2.5rem; }
  .pf-chapter-head .eyebrow { margin-bottom: .6rem; }
  .pf-big-n { font-size: clamp(4.5rem, 14vw, 10rem); line-height: .8; color: transparent; -webkit-text-stroke: 1px var(--accent); }
  .pf-lesson { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2rem 4rem; background: var(--paper); color: var(--ink); border-radius: 0 var(--radius) var(--radius) var(--radius); padding: clamp(1.6rem, 4vw, 2.6rem); }
  .pf-lesson .eyebrow { color: var(--plum-2); }
  .pf-definition { font-family: var(--font-serif); font-size: clamp(1.35rem, 2.4vw, 1.75rem); line-height: 1.3; margin: 0; font-weight: 500; }
  .pf-lesson .services { margin-top: 0; }
  .pf-lesson .services li::before { background: var(--plum-2); }
  .pf-lesson .note { color: #4d4755; margin-top: 1.4rem; border-left-color: var(--plum-2); }
  .pf-case { margin-top: clamp(3rem, 6vw, 4.5rem); }
  .pf-case > .card-title { font-size: clamp(1.8rem, 3.4vw, 2.6rem); margin-bottom: .8rem; }
  .pf-case-text { max-width: 60ch; margin: 0 0 2.5rem; }
  .pf-h4 { font-size: 1.45rem; margin: .4rem 0 .6rem; }
  .pf-sub { margin-top: 3.5rem; }
  .pf-exercise { margin-top: clamp(3rem, 6vw, 4rem); padding: 1.6rem 1.8rem; border-radius: var(--radius) var(--radius) var(--radius) 0; border: 1px dashed var(--lilac); background: rgba(184,156,224,.06); }
  .pf-exercise p:last-child { margin: 0; font-family: var(--font-serif); font-size: clamp(1.2rem, 2vw, 1.45rem); line-height: 1.35; }

  /* Antes / depois */
  .pf-ba { border-radius: var(--radius); overflow: hidden; border: 1px solid rgba(255,255,255,.1); }
  .pf-ba-row { display: grid; grid-template-columns: 10rem 1fr 1fr; gap: 1rem; padding: 1rem 1.4rem; align-items: baseline; }
  .pf-ba-row + .pf-ba-row { border-top: 1px solid rgba(255,255,255,.08); }
  .pf-ba-head { background: rgba(255,255,255,.04); font-size: .85rem; letter-spacing: .2em; text-transform: uppercase; color: var(--paper-muted); }
  .pf-ba-row .eyebrow { margin: 0; font-size: .75rem; }
  .pf-before { color: var(--paper-muted); text-decoration: line-through; text-decoration-color: rgba(189,183,196,.5); }
  .pf-after { font-family: var(--font-serif); font-size: 1.25rem; font-weight: 500; }
  .pf-palette { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 1rem; }
  .pf-palette li { display: grid; gap: .35rem; }
  .pf-swatch { display: block; height: 7rem; border-radius: var(--radius) var(--radius) var(--radius) 0; margin-bottom: .6rem; border: 1px solid rgba(255,255,255,.1); }
  .pf-palette strong { font-family: var(--font-serif); font-weight: 600; font-size: 1.3rem; }
  .pf-palette .muted { font-size: 1rem; }
  blockquote.quote footer { margin-top: 1rem; }

  /* Ecossistema */
  .pf-eco { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 4rem; align-items: center; }
  .pf-map { position: relative; aspect-ratio: 400 / 340; max-width: 520px; width: 100%; margin: 0 auto; }
  .pf-map svg { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--accent); }
  .pf-map svg path { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-dasharray: 5 6; marker-end: url(#pf-arrow); animation: pf-dash 1.6s linear infinite; }
  @keyframes pf-dash { to { stroke-dashoffset: -22; } }
  .pf-node { position: absolute; width: 38%; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; display: grid; place-content: center; gap: .15rem; text-align: center; cursor: pointer; padding: .5rem; color: var(--paper); font-family: var(--font-sans); font-weight: 300; background: radial-gradient(circle at 30% 25%, var(--plum-2), var(--ink-deep)); border: 1px solid rgba(184,156,224,.35); transition: transform .25s ease, background .25s ease, box-shadow .25s ease; }
  .pf-node:hover { transform: translate(-50%, -50%) scale(1.04); }
  .pf-node[aria-pressed='true'] { background: var(--lilac); color: var(--ink-deep); border-color: var(--lilac); box-shadow: 0 0 0 8px rgba(184,156,224,.15); }
  .pf-node:focus-visible { outline: 2px solid var(--lilac); outline-offset: 4px; }
  .pf-node strong { font-family: var(--font-serif); font-weight: 600; font-size: clamp(1rem, 2.2vw, 1.35rem); line-height: 1.05; }
  .pf-node-job { font-size: clamp(.6rem, 1.2vw, .72rem); letter-spacing: .18em; text-transform: uppercase; opacity: .8; }
  .pf-node-role { font-size: clamp(.7rem, 1.3vw, .85rem); opacity: .8; }
  .pf-node-bia { left: 50%; top: 19%; }
  .pf-node-empower { left: 80%; top: 76%; }
  .pf-node-boss { left: 20%; top: 76%; }
  .pf-panel { border-left: 2px solid var(--lilac); padding-left: 1.4rem; }
  .pf-panel p { margin: 0 0 1rem; }
  .pf-panel-title { font-size: clamp(2rem, 4vw, 3rem); margin: 0 0 1rem; }
  .pf-gives { font-family: var(--font-serif); font-size: 1.25rem; }
  .pf-flow { counter-reset: flow; display: grid; gap: .6rem; margin-top: 2rem; padding-top: 1.6rem; border-top: 1px solid rgba(255,255,255,.08); }
  .pf-flow li { counter-increment: flow; display: grid; grid-template-columns: 1.8rem 1fr; color: var(--paper-muted); font-size: 1rem; }
  .pf-flow li::before { content: counter(flow) '→'; color: var(--lilac); font-size: .85rem; }
  .pf-steps-4 { grid-template-columns: repeat(4, 1fr); margin-top: 1.4rem; }

  /* Glossário */
  .pf-glossary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin: 0; }
  .pf-glossary div { border-top: 1px solid var(--accent); padding-top: 1.2rem; }
  .pf-glossary dt { font-family: var(--font-serif); font-weight: 600; font-size: 1.4rem; margin-bottom: .4rem; }
  .pf-glossary dd { margin: 0; color: var(--paper-muted); }

  @media (max-width: 900px) {
    .pf-order, .pf-steps-4 { grid-template-columns: 1fr 1fr; }
    .pf-lesson, .pf-eco, .pf-palette { grid-template-columns: 1fr; }
    .pf-glossary { grid-template-columns: 1fr 1fr; }
    .pf-swatch { height: 4.5rem; }
  }
  @media (max-width: 560px) {
    .pf-order, .pf-steps-4, .pf-glossary { grid-template-columns: 1fr; }
    .pf-ba-row { grid-template-columns: 1fr 1fr; }
    .pf-ba-row > :first-child { grid-column: 1 / -1; }
    .pf-ba-head > :first-child { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pf-map svg path { animation: none; }
  }
</style>
