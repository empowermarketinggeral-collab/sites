---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base title="Página não encontrada — Empower Marketing" quiz={false}>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Erro 404</p>
      <h1 class="display page-title">Esta página não ocupa <span class="accent">nenhuma posição.</span></h1>
      <p class="lead">O endereço pode ter mudado. Começa pelo início.</p>
      <div class="actions"><Button href="/" variant="light">Voltar ao início</Button></div>
    </div>
  </section>
</Base>
