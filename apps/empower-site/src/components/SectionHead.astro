---
interface Props { eyebrow?: string; title: string; subtitle?: string; center?: boolean; small?: boolean }
const { eyebrow, title, subtitle, center = false, small = false } = Astro.props;
---
<header class:list={['section-head', { center }]}>
  {eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
  <h2 class:list={['display section-title reveal', { 'section-title-sm': small }]}>{title}{subtitle && <><br /><span class="accent">{subtitle}</span></>}</h2>
</header>
