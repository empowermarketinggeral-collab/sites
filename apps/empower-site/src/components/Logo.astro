---
// Marca Empower: estrela de quatro pontas sobre o nome.
---
<span class="logo" aria-label="Empower Marketing">
  <svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true">
    <path d="M20 1 C21.5 13 27 18.5 39 20 C27 21.5 21.5 27 20 39 C18.5 27 13 21.5 1 20 C13 18.5 18.5 13 20 1Z" fill="currentColor" />
    <circle cx="20" cy="20" r="3.2" fill="var(--ink-deep)" />
  </svg>
  <span class="logo-word">EMPOWER</span>
  <span class="logo-sub">MARKETING</span>
</span>

<style>
  .logo { display: inline-flex; flex-direction: column; align-items: center; color: var(--paper); line-height: 1; }
  .logo-word { font-family: var(--font-serif); font-size: 1.05rem; letter-spacing: .02em; margin-top: .35rem; }
  .logo-sub { font-family: var(--font-serif); font-size: .55rem; letter-spacing: .18em; align-self: flex-end; opacity: .8; }
</style>
