---
// Logótipo oficial (branco, fundo transparente), a partir do manual de marca.
interface Props { size?: 'header' | 'footer' }
const { size = 'header' } = Astro.props;
---
<picture class:list={['logo', `logo-${size}`]}>
  <source srcset="/images/logo.webp" type="image/webp" />
  <img src="/images/logo.png" alt="Empower Marketing" width="480" height="405" decoding="async" />
</picture>

<style>
  .logo { display: block; line-height: 0; }
  .logo img { height: 100%; width: auto; }
  .logo-header { height: 84px; }
  .logo-footer { height: 110px; }
  @media (max-width: 560px) { .logo-header { height: 68px; } }
</style>
