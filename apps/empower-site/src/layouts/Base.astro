---
// Só o alfabeto latino (cobre o português): menos ficheiros de letra a descarregar.
import '@fontsource/gloock/latin-400.css';
import '@fontsource/josefin-sans/latin-300.css';
import '@fontsource/josefin-sans/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import gloockFont from '@fontsource/gloock/files/gloock-latin-400-normal.woff2?url';
import josefinFont from '@fontsource/josefin-sans/files/josefin-sans-latin-300-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuizCta from '../components/QuizCta.astro';
import CookieConsent from '../components/CookieConsent.astro';
import site from '../data/site.json';

// quiz: bloco de lead magnet no fim da página (desligado até haver um novo).
// noindex: páginas privadas (ex.: reunião agendada) que não devem aparecer no Google.
interface Props { title?: string; description?: string; quiz?: boolean; type?: 'website' | 'article'; noindex?: boolean }
const { title = site.meta.title, description = site.meta.description, quiz = false, type = 'website', noindex = false } = Astro.props;
// No build o caminho vem como /servicos.html; o endereço público é /servicos.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = new URL(path, site.meta.url).href;
const ogImage = new URL('/images/og.jpg', site.meta.url).href;

// Dados estruturados da empresa (Google, assistentes de IA): o que fazemos, onde e para quem.
const home = new URL('/', site.meta.url).href;
const orgLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${home}#empresa`,
    name: site.company.name,
    description: site.seo.businessDescription,
    url: home,
    logo: new URL('/images/logo.png', site.meta.url).href,
    image: ogImage,
    email: site.company.email,
    telephone: site.company.phone.replace(/\s/g, ''),
    founder: { '@type': 'Person', name: site.company.owner },
    address: { '@type': 'PostalAddress', streetAddress: site.seo.street, postalCode: site.seo.postalCode, addressLocality: site.seo.city, addressCountry: 'PT' },
    areaServed: { '@type': 'Country', name: site.seo.areaServed },
    knowsAbout: site.seo.keywords,
    priceRange: '€€€',
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.company.name, url: home, inLanguage: 'pt-PT', publisher: { '@id': `${home}#empresa` } },
]);
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={gloockFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={josefinFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1c0f2e" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Empower Marketing" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={site.meta.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {site.analytics.hubUrl && <script is:inline defer src={`${site.analytics.hubUrl}/t.js`} data-site={site.analytics.siteId}></script>}
    {!noindex && <script type="application/ld+json" set:html={orgLd} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#conteudo">Saltar para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    {quiz && <QuizCta />}
    <Footer />
    <CookieConsent />
    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal');
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
